SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Optional AI LLM Keys for Enhanced Real-Time Querying
GEMINI_API_KEY=
OPENAI_API_KEY=
